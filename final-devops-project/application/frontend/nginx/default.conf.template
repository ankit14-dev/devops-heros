# Rendered at container start by the official nginx image (envsubst on /etc/nginx/templates/*.template).
# BACKEND_URL = where the API lives: http://backend:8000 in compose, http://<release>-backend:8000 in Kubernetes.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # frontend's own liveness endpoint (does not depend on the backend)
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
}
